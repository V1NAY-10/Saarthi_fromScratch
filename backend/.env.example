# Deterministic, offline-safe demo. Diagnosis, decisions and partner flows never depend on the LLM.
DEMO_MODE=true

# Optional: when DEMO_MODE=false and a key is present, Claude writes the customer-facing
# explanations and powers free-form chat. All numbers it uses are grounding-checked.
ANTHROPIC_API_KEY=
SAARTHI_MODEL=claude-opus-5-5
