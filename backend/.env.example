# Set to false to enable the Gemini-powered failure engine and chat.
DEMO_MODE=false

# Gemini API key — powers failure detection, analysis, and chat.
# Get yours at https://aistudio.google.com/
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini

# ---- Deployment (optional; local defaults shown)
# Where the SQLite DB, uploaded documents and signing secret live. Use a persistent volume in production.
# SAARTHI_DATA_DIR=./
# Secret for signed document URLs. Set it in production; otherwise one is generated into SAARTHI_DATA_DIR.
# SAARTHI_STORAGE_SECRET=
# Comma-separated browser origins allowed to call the API (only needed if the frontend is hosted elsewhere).
# CORS_ORIGINS=*
# Store documents in Cloudinary instead of local disk (requires `pip install cloudinary`).
# CLOUDINARY_URL=
